# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=

# Model the target agent runs on. gpt-4.1-mini is the baseline: strong policy,
# weaker model, so hand-written attacks land often enough to measure.
# gpt-5.4 resisted the whole corpus (0/23) — useful as a hardened comparison.
TARGET_MODEL=gpt-4.1-mini

# Model that grades transcripts (Phase 04). Keep this stronger than the target:
# a weak judge under-reports leaks. One call per scored transcript.
JUDGE_MODEL=gpt-5.4

# Hard cap on agent-loop turns per conversation (one turn = one model call)
TARGET_MAX_TURNS=8
